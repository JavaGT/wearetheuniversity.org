<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.shortName or "WEARETHEUNIVERSITY" }}</title>
  <meta name="description" content="{{ excerpt or site.name }}">
  <link rel="stylesheet" href="/style.css">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
</head>
<body class="site-{{ site.kind or 'www' }}">
  {# Shared header: identical on every host; only the red underline moves. #}
  {% set onWww = not site.isBlog and not site.isArchive %}
  {% set wwwBase = "" if onWww else site.wwwUrl %}
  <header>
    <h1 class="logo"><a href="/">We Are The University</a></h1>
    <nav aria-label="Primary">
      <ul>
        <li><a href="{{ wwwBase }}/"{% if onWww and page.url == "/" %} aria-current="page"{% endif %}>Home</a></li>
        <li><a href="{{ wwwBase }}/about/"{% if onWww and "/about/" in page.url %} aria-current="page"{% endif %}>About</a></li>
        <li><a href="{{ wwwBase }}/contact/"{% if onWww and "/contact/" in page.url %} aria-current="page"{% endif %}>Contact</a></li>
        <li><a href="{{ "/" if site.isBlog else site.blogUrl + "/" }}"{% if site.isBlog %} aria-current="page"{% endif %}>Blog</a></li>
        <li><a href="{{ "/" if site.isArchive else site.archiveUrl + "/" }}"{% if site.isArchive %} aria-current="page"{% endif %}>Archive</a></li>
        <li><a href="{{ wwwBase }}/arcade/"{% if onWww and "/arcade/" in page.url %} aria-current="page"{% endif %}>Arcade</a></li>
        <li><a href="{{ wwwBase }}/tools/"{% if onWww and "/tools/" in page.url %} aria-current="page"{% endif %}>Tools</a></li>
      </ul>
    </nav>
  </header>
  <main>
    {{ content | safe }}
    {% if author or to %}
      <div class="authors-meta">
        {% if author %}<div><strong>From:</strong> {{ author }}</div>{% endif %}
        {% if to %}<div><strong>To:</strong> {{ to }}</div>{% endif %}
      </div>
    {% endif %}
  </main>
  <footer class="site-footer">
    <p><a href="/">WEARETHEUNIVERSITY</a></p>
  </footer>
</body>
</html>
