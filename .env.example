# Copy to .env (never commit .env). Used for privacy redaction and optional tools.
# Longer phrases first recommended. Bare short words match with word boundaries.

# Comma-separated personal identifiers to strip from all site content
# Example (replace with your real identifiers locally):
# REDACT_IDENTIFIERS=Full Name,username123,user.name,user.name@example.com,personal-domain.com,githubhandle
REDACT_IDENTIFIERS=

# What to replace matches with
REDACT_REPLACEMENT=[REDACTED]

# Ignore tokens shorter than this (avoids over-matching)
REDACT_MIN_LENGTH=3

# Optional: Scoop incremental fetch keywords (comma-separated)
SCOOP_KEYWORDS=University of Auckland,Waipapa Taumata Rau,TEU,Marsden,tertiary education

# Optional: OIA / FYI.org.nz search keywords
OIA_KEYWORDS=University of Auckland,Vice-Chancellor,course cuts

# Optional: public pages to poll for change detection (one URL per line in this var, comma-separated)
PAGE_WATCH_URLS=https://www.auckland.ac.nz/en.html
